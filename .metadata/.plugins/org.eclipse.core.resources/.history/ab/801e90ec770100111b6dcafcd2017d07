#define VREF            3.3f    
#define ADCMAX          4095.0f

#define R_SERIES        1000.0f    
#define R_NTC_25C       100500.0f  

#define BETA_LOW        3950.0f    
#define BETA_HIGH       4420.0f
#define R_CROSSOVER     1500.0f    
#define T_25C_K         298.15f

//#define T_SET_C         250.0f   

