// --- IMPLEMENTACIÓN DEL PID ---
float PID_Compute(PID_Config *pid, float setpoint, float measured_value, float dt_seconds) {
    float error = setpoint - measured_value;
    
    // --- TÉRMINO P ---
    float P = pid->Kp * error;
    
    // --- TÉRMINO I (Con ventana) ---
    // Mantenemos la ventana para evitar windup en el arranque frío
    if (fabs(error) < 15.0f) { 
        pid->integral += error * dt_seconds;
    } else {
        pid->integral = 0.0f; 
    }
    
    float I_term = pid->Ki * pid->integral; 
    
    // Anti-Windup estricto
    if (I_term > 100.0f) { I_term = 100.0f; pid->integral = 100.0f / pid->Ki; }
    else if (I_term < -20.0f) { I_term = -20.0f; pid->integral = -20.0f / pid->Ki; } // Permitimos un poco de I negativo

    // --- TÉRMINO D (El Amortiguador) ---
    // Calculamos la derivada sobre la MEDICIÓN, no sobre el error.
    // Esto evita el "Kick" si cambias el setpoint, y suaviza la curva.
    // dInput = (medida_actual - medida_anterior) / dt
    // D = - Kd * dInput
    
    // Nota: Como 'error = setpoint - medida', dError/dt es equivalente a -dMedida/dt (si setpoint es fijo).
    // Tu código usa (error - prevError), que está bien.
    
    float derivative = (error - pid->prevError) / dt_seconds;
    float D = pid->Kd * derivative;
    
    pid->prevError = error;
    
    // Suma final
    float output = P + I_term + D;
    
    // >>> AQUÍ ESTÁ EL CAMBIO CLAVE <<<
    // Eliminamos el "if (error < 0) output = 0;"
    // Dejamos que el PID decida. Si el PID calcula negativo, el clamp de abajo lo pone en 0.
    // Pero si el PID calcula 5% aunque estemos en 251°C (por efecto del término D frenando la caída),
    // ¡permitimos que actúe!
    
    if (output > 100.0f) output = 100.0f;
    if (output < 0.0f) output = 0.0f; 
    
    return output;
}

